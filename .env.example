# --- Required ---------------------------------------------------------------
# Railway: add a Postgres service, then reference it in this service as
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:password@localhost:5432/vehicle_log

# Long random string used to sign login cookies (32+ chars).
# Generate one:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Who may log in: comma-separated "name:password" pairs.
# The FIRST user is the admin (can delete anyone's entries). Avoid commas and
# leading/trailing spaces in passwords. Use long passwords (16+ chars).
USERS=james:use-a-long-unique-password,friend1:another-long-unique-password

# --- Optional ---------------------------------------------------------------
# Timezone used for displaying dates and in the PDF (default Europe/Madrid)
APP_TIMEZONE=Europe/Madrid

# Days after an entry before you are reminded to re-check (default 10)
RECHECK_DAYS=10

# Force SSL to Postgres (auto-enabled for Railway public proxy URLs)
# PGSSL=true
